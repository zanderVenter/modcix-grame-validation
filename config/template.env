# Copy this file to config/.env and fill in your own values.
# config/.env is git-ignored - never commit it.

# --- Google Earth Engine / Google Cloud project ---
# Your own GEE-enabled GCP project (do NOT use someone else's project ID here).
# Used for ee.Initialize(), gcloud/gsutil auth, and as the Planet->GEE delivery target.
GEEPROJECT=your-gee-project-id
# A GCS bucket in that project, used as scratch space for raster ingestion
GCLOUDBUCKET=your-gcs-bucket-name
# The GEE asset root - the projects/<root>/... prefix your permanent assets live under.
# This is NOT necessarily the same as GEEPROJECT above: legacy (pre-Cloud-projects) GEE
# asset roots are just a namespace you have access to, unrelated to any GCP project.
# If you only use modern Cloud-native assets, this can be the same value as GEEPROJECT.
GEEASSETROOT=your-gee-asset-root

# --- Planet Labs API ---
# https://www.planet.com/account/#/ -> API key
PLANETAPI=your-planet-api-key

# --- WEkEO (Copernicus Climate/Land data access) ---
# https://www.wekeo.eu/ account used to download the official GRAME product
WEKEOUSER=your-wekeo-username
WEKEOPW=your-wekeo-password

# --- Local data path ---
# Root folder holding the project's geospatial data (grids, GRAME rasters, samples).
# Not tracked in git - see README for expected layout.
PROJDIR=/path/to/local/project/data
